{
	"schemaVersion": 1,
	"id": "dropcount",
	"version": "${version}",
	"name": "Drop Count",
	"description": "Shows the item name and stack size above dropped items, merging stacks that are too big to combine and keeping overlapping labels readable.",
	"authors": ["wlm3201"],
	"contact": {
		"sources": "https://github.com/wlm3201/drop-count"
	},
	"license": "GPL v3",
	"icon": "assets/dropcount/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.dropcount.client.DropCountClient"],
		"modmenu": ["com.dropcount.client.integration.ModMenuIntegration"]
	},
	"mixins": [
		{
			"config": "dropcount.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"java": ">=25",
		"minecraft": "${minecraft_dependency}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
}
